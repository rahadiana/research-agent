<% var title = 'Final Report — ' + root.query.topic; %>

<style>
  .final-report h1 { font-size: 1.6rem; font-weight: 700; color: #f1f5f9; margin-bottom: 0.75rem; }
  .final-report h2 { font-size: 1.15rem; font-weight: 600; color: #e2e8f0; margin-top: 1.75rem; margin-bottom: 0.6rem; padding-bottom: 0.4rem; border-bottom: 1px solid rgba(148,163,184,0.15); }
  .final-report h3 { font-size: 1rem; font-weight: 600; color: #cbd5e1; margin-top: 1.25rem; margin-bottom: 0.5rem; }
  .final-report h4, .final-report h5, .final-report h6 { font-size: 0.9rem; font-weight: 600; color: #94a3b8; margin-top: 1rem; margin-bottom: 0.4rem; }
  .final-report p { margin-bottom: 0.9rem; line-height: 1.85; color: #cbd5e1; }
  .final-report blockquote { border-left: 3px solid #10b981; padding-left: 1rem; color: #94a3b8; font-size: 0.85rem; margin-bottom: 1rem; }
  .final-report ul, .final-report ol { margin: 0.5rem 0; padding-left: 1.25rem; }
  .final-report li { margin-bottom: 0.35rem; line-height: 1.7; color: #94a3b8; }
  .final-report hr { border-color: rgba(148,163,184,0.15); margin: 1.5rem 0; }
  .final-report a { color: #34d399; text-decoration: none; }
  .final-report a:hover { text-decoration: underline; }
</style>

<!-- Header -->
<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-3 mb-2">
      <a href="/research/<%= root.id %>" class="flex items-center justify-center w-8 h-8 rounded-xl bg-slate-800/50 text-slate-400 hover:text-slate-200 hover:bg-slate-700/50 transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      </a>
      <div>
        <h1 class="text-2xl font-bold text-white truncate">Final Report — <%= root.query.topic %></h1>
        <p class="text-xs text-slate-500 mt-1">
          <%= tree.length %> riset (induk + sub-query) · <%= tree.reduce(function(s, r) { return s + r.sources.length; }, 0) %> total sumber
        </p>
      </div>
    </div>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <a href="/research/<%= root.id %>/final-report/export/markdown" class="flex items-center gap-1.5 bg-emerald-600/80 hover:bg-emerald-500 text-white px-3.5 py-2 rounded-xl text-xs font-medium transition-all shadow-lg shadow-emerald-500/20">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3"/></svg>
      Export Markdown
    </a>
    <a href="/research/<%= root.id %>" class="flex items-center gap-1.5 bg-slate-800/50 hover:bg-slate-700/50 text-slate-300 hover:text-slate-100 px-3.5 py-2 rounded-xl text-xs font-medium border border-slate-600/30 transition-all">
      Detail Riset
    </a>
  </div>
</div>

<!-- Struktur pohon -->
<div class="glass-card rounded-2xl p-4 mb-6">
  <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Struktur Pohon</h3>
  <div class="space-y-1.5 text-sm">
    <% tree.forEach(function(r, i) { %>
      <% var isRoot = i === 0; %>
      <div class="flex items-center gap-2">
        <% if (isRoot) { %>
          <span class="text-emerald-400">&#9679;</span>
        <% } else { %>
          <span class="text-slate-600">&#9495;&#9472;</span>
        <% } %>
        <a href="/research/<%= r.id %>" class="<%= isRoot ? 'text-emerald-400 font-semibold' : 'text-slate-300' %> hover:underline truncate">
          <%= r.query.topic %>
        </a>
        <span class="text-xs text-slate-500 shrink-0"><%= r.sources.length %> src</span>
        <% if (!isRoot) { %>
          <span class="text-[10px] px-1.5 py-0.5 rounded-md bg-blue-500/10 text-blue-400 shrink-0">sub</span>
        <% } %>
      </div>
    <% }); %>
  </div>
</div>

<!-- Isi Final Report -->
<div class="glass-card rounded-2xl p-6 md:p-8">
  <div class="final-report text-sm max-w-none">
    <%- reportHtml %>
  </div>
</div>
